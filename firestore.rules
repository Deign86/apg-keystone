rules_version = '2';

// Who may read and change Keystone's records in Firestore (docs/adr/0009). Deploy with `firebase deploy --only firestore:rules`.
//
//   keystone/{company}                   the records have been started: { status: 'ready', by, at } (docs/adr/0018)
//   keystone/{company}/members/{uid}     who may open the records: { role: 'owner' | 'staff', name, email }
//   keystone/{company}/{list}/{id}       one record each: { pos, body } (list is dir, cv, bs, ids, log or ext)
//   keystone/{company}/company/details   the company's details: { pos, body } (docs/adr/0018)
//   keystone/{company}/rf/{no}           a request for funds: { pos, body, status, uid, decision } (docs/adr/0011)
//   keystone/{company}/idreg/{no}        an issued employee ID, named by its number: { id, year, seq, name, …, kind, by } (docs/adr/0025)
//   keystone/{company}/idreg/{no}/replacements/{at}   a replacement card for that number (docs/adr/0025)
//   keystone/{company}/devices/{uid}     a kiosk's own account, which reads the ID register: { name } (docs/adr/0026)
//   keystone/{company}/att_{table}/{id}  the attendance kiosk's records, one per row (docs/adr/0027, 0028)
//   keystone/{company}/attprivate_{table}/{id}  the TIN and bank account number of that row, kept apart (docs/adr/0028)
//
// The records are only ever what members save here: an owner starts them empty, and Keystone copies nothing in from a
// computer. Only an owner starts them and changes the company's details, which every document prints (payment
// instructions name the account clients pay into), so no other member can change where money goes.
//
// Only members can read or write anything. Only an owner adds, changes or removes members: Keystone's User Accounts
// screen makes and removes staff members (docs/adr/0014, 0015), and the first owner is added by hand in the Firebase
// console (docs/FIREBASE.md). A sign-in nobody made a member, or whose member was removed, opens nothing. A member
// changes only their own name (Profile, docs/adr/0020), never their role.
//
// The register of issued employee IDs is written by the Alpha Premier ID Maker (Deign86/apg-id-creator), not by
// Keystone. A member reads it and adds to it, as themselves; nobody changes or removes an issued ID from an app, so a
// number given once cannot be given again, overwritten or lost. A replacement card is recorded under the card it
// replaces, which stays as it was.
//
// A device is not a member. It is an account an owner lists under devices for a kiosk, such as the attendance tracker
// (Deign86/alpha-premier-attendance), which takes new interns from the register. It reads issued IDs and its own
// device document. The one thing it writes is its own records under att_… and attprivate_…, which it reads back to
// rebuild itself on a new computer; besides it only an owner reads those. These documents are the attendance records
// (docs/adr/0028); the kiosk is their only writer, so Keystone never writes them.
//
// Only an owner reads every request for funds and decides them; any other member reads, files, edits and withdraws
// only their own, and only while it waits. Keystone reads a request's status, requester and decision from the fields
// beside its body, so a body edited past these rules changes none.
service cloud.firestore {
  match /databases/{database}/documents {
    function member(company) {
      return request.auth != null
        && exists(/databases/$(database)/documents/keystone/$(company)/members/$(request.auth.uid));
    }

    function owner(company) {
      return member(company)
        && get(/databases/$(database)/documents/keystone/$(company)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function device(company) {
      return request.auth != null
        && exists(/databases/$(database)/documents/keystone/$(company)/devices/$(request.auth.uid));
    }

    function record() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pos', 'body']) && d.pos is int && d.pos >= 0 && d.body is string && d.body.size() < 900000;
    }

    function marker() {
      let d = request.resource.data;
      return d.keys().hasOnly(['status', 'by', 'at']) && d.status == 'ready' && d.by == request.auth.uid;
    }

    function fundsRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pos', 'body', 'status', 'uid', 'decision']) && d.pos is int && d.pos >= 0
        && d.body is string && d.body.size() < 900000 && d.status in ['For Approval', 'Approved', 'Declined', 'Withdrawn']
        && (!('uid' in d) || d.uid is string) && (!('decision' in d) || d.decision is map);
    }

    // An issued employee ID as the ID Maker writes it: named by its own number, and signed by whoever is asking. `kind`
    // says who the ID is for, an intern or an employee; an ID Maker from before it asked (v2.0.3) sends none.
    function issuedId(no) {
      let d = request.resource.data;
      return no.matches('^APG-[0-9]{4}-[0-9]{3,6}$')
        && d.keys().hasOnly(['id', 'year', 'seq', 'name', 'title', 'issuedAt', 'replacement', 'last', 'first', 'middle', 'suffix', 'role1', 'role2', 'kind', 'by', 'byEmail'])
        && d.keys().hasAll(['id', 'year', 'seq', 'name', 'issuedAt', 'replacement', 'by'])
        && d.id == no && d.year is int && d.seq is int && d.seq > 0
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.issuedAt is string && d.issuedAt.size() <= 40
        && d.replacement is bool
        && (!('kind' in d) || d.kind in ['intern', 'employee'])
        && d.by == request.auth.uid;
    }

    // A request a member files, edits or withdraws: their own, waiting or withdrawn, and with no decision.
    function ownUndecided(d) {
      return d.uid == request.auth.uid && d.status in ['For Approval', 'Withdrawn'] && !('decision' in d);
    }

    match /keystone/{company} {
      allow read: if member(company);
      allow create, update: if owner(company) && marker();

      match /members/{uid} {
        allow read: if member(company);
        allow write: if owner(company);
        // Anyone signed in changes their own name on Profile, and nothing else of theirs (docs/adr/0020).
        allow update: if member(company) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      }

      // A kiosk's account (docs/adr/0026). Only an owner lists, renames or removes one; a device sees only its own.
      match /devices/{uid} {
        allow read: if owner(company) || (request.auth != null && uid == request.auth.uid);
        allow create, update: if owner(company) && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
        allow delete: if owner(company);
      }

      // The attendance kiosk's records (docs/adr/0027, 0028): written by a device, read by that device and an owner,
      // and by nobody else. TINs and bank account numbers sit apart under attprivate_…, so a later rule that lets
      // someone else read att_… cannot show them by accident.
      match /{backup}/{id} {
        allow read: if backup.matches('att_[a-z_]+') && (owner(company) || device(company));
        allow write: if backup.matches('att_[a-z_]+') && device(company);
        allow read: if backup.matches('attprivate_[a-z_]+') && (owner(company) || device(company));
        allow write: if backup.matches('attprivate_[a-z_]+') && device(company);
      }

      match /company/{id} {
        allow read: if member(company);
        allow create, update: if owner(company) && id == 'details' && record();
        // An owner restoring a backup made before there were company details.
        allow delete: if owner(company);
      }

      // An owner may write any request (deciding it, restoring a backup). Anyone else files one as
      // themselves, waiting for a decision, and changes it only while it still waits.
      match /rf/{no} {
        allow read: if owner(company) || (member(company) && resource.data.uid == request.auth.uid);
        allow create: if fundsRequest() && (owner(company)
          || (member(company) && request.resource.data.status == 'For Approval' && ownUndecided(request.resource.data)));
        allow update: if fundsRequest() && (owner(company)
          || (member(company) && resource.data.status == 'For Approval' && resource.data.uid == request.auth.uid && ownUndecided(request.resource.data)));
        allow delete: if owner(company);
      }

      // Issued employee IDs (docs/adr/0025). Created only: there is no update and no delete, for an owner either, so
      // creating the document of a number that already has one is refused, and the first card stands.
      // A device reads them too, and only reads: the cards themselves, not the replacements under them.
      match /idreg/{no} {
        allow read: if member(company) || device(company);
        allow create: if member(company) && issuedId(no);

        match /replacements/{at} {
          allow read: if member(company);
          allow create: if member(company) && issuedId(no) && request.resource.data.replacement == true;
        }
      }

      match /{list}/{id} {
        allow read: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'];
        allow create, update: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'] && record();
        allow delete: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'];
      }
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
