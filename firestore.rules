rules_version = '2';

// Who may read and change Keystone's records in Firestore (docs/adr/0009). Deploy with `firebase deploy --only firestore:rules`.
//
//   keystone/{company}                   the records have been started: { status: 'ready', by, at } (docs/adr/0018)
//   keystone/{company}/members/{uid}     who may open the records: { role: 'owner' | 'staff', name, email }
//   keystone/{company}/{list}/{id}       one record each: { pos, body } (list is dir, cv, bs, ids, log or ext)
//   keystone/{company}/company/details   the company's details: { pos, body } (docs/adr/0018)
//   keystone/{company}/rf/{no}           a request for funds: { pos, body, status, uid, decision } (docs/adr/0011)
//
// The records are only ever what members save here: an owner starts them empty, and Keystone copies nothing in from a
// computer. Only an owner starts them and changes the company's details, which every document prints (payment
// instructions name the account clients pay into), so no other member can change where money goes.
//
// Only members can read or write anything. Only an owner adds, changes or removes members: Keystone's User Accounts
// screen makes and removes staff members (docs/adr/0014, 0015), and the first owner is added by hand in the Firebase
// console (docs/FIREBASE.md). A sign-in nobody made a member, or whose member was removed, opens nothing. A member
// changes only their own name (Profile, docs/adr/0020), never their role.
//
// Only an owner reads every request for funds and decides them; any other member reads, files, edits and withdraws
// only their own, and only while it waits. Keystone reads a request's status, requester and decision from the fields
// beside its body, so a body edited past these rules changes none.
service cloud.firestore {
  match /databases/{database}/documents {
    function member(company) {
      return request.auth != null
        && exists(/databases/$(database)/documents/keystone/$(company)/members/$(request.auth.uid));
    }

    function owner(company) {
      return member(company)
        && get(/databases/$(database)/documents/keystone/$(company)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function record() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pos', 'body']) && d.pos is int && d.pos >= 0 && d.body is string && d.body.size() < 900000;
    }

    function marker() {
      let d = request.resource.data;
      return d.keys().hasOnly(['status', 'by', 'at']) && d.status == 'ready' && d.by == request.auth.uid;
    }

    function fundsRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pos', 'body', 'status', 'uid', 'decision']) && d.pos is int && d.pos >= 0
        && d.body is string && d.body.size() < 900000 && d.status in ['For Approval', 'Approved', 'Declined', 'Withdrawn']
        && (!('uid' in d) || d.uid is string) && (!('decision' in d) || d.decision is map);
    }

    // A request a member files, edits or withdraws: their own, waiting or withdrawn, and with no decision.
    function ownUndecided(d) {
      return d.uid == request.auth.uid && d.status in ['For Approval', 'Withdrawn'] && !('decision' in d);
    }

    match /keystone/{company} {
      allow read: if member(company);
      allow create, update: if owner(company) && marker();

      match /members/{uid} {
        allow read: if member(company);
        allow write: if owner(company);
        // Anyone signed in changes their own name on Profile, and nothing else of theirs (docs/adr/0020).
        allow update: if member(company) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      }

      match /company/{id} {
        allow read: if member(company);
        allow create, update: if owner(company) && id == 'details' && record();
        // An owner restoring a backup made before there were company details.
        allow delete: if owner(company);
      }

      // An owner may write any request (deciding it, moving the records in, restoring a backup). Anyone else files one as
      // themselves, waiting for a decision, and changes it only while it still waits.
      match /rf/{no} {
        allow read: if owner(company) || (member(company) && resource.data.uid == request.auth.uid);
        allow create: if fundsRequest() && (owner(company)
          || (member(company) && request.resource.data.status == 'For Approval' && ownUndecided(request.resource.data)));
        allow update: if fundsRequest() && (owner(company)
          || (member(company) && resource.data.status == 'For Approval' && resource.data.uid == request.auth.uid && ownUndecided(request.resource.data)));
        allow delete: if owner(company);
      }

      match /{list}/{id} {
        allow read: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'];
        allow create, update: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'] && record();
        allow delete: if member(company) && list in ['dir', 'cv', 'bs', 'ids', 'log', 'ext'];
      }
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
