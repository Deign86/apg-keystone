# The Firebase project Keystone keeps its records in (docs/adr/0009, docs/FIREBASE.md).
# Copy to .env.local (never committed) and fill in from the Firebase console: Project settings › Your apps › Web app.
# Leave them empty and Keystone keeps its records on this computer only, as before.
# These name the project; they are not secrets. Access is decided by signing in and by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional; defaults to <project id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
