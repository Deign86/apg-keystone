<p class="m-0 min-h-4 font-bold">
</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Checked by</p>
</div>
<div class="relative border-t border-paper-ink pt-1 text-[11px]">
<p class="m-0 min-h-4 font-bold">
</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Approved by</p>
</div>
</div>
</article>
</div>
