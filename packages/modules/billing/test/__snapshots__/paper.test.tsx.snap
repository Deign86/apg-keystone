<td class="px-2.5 py-1.5 border-l border-paper-line text-right whitespace-nowrap tabular-nums">₱42,000.00</td>
</tr>
</tbody>
<tfoot>
</tfoot>
</table>
<table aria-label="Totals" class="mt-3 w-full border-collapse border border-paper-ink">
<tbody>
<tr class=" ">
