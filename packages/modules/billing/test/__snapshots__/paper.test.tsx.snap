<dd class="m-0 font-bold uppercase">Novatek BPO Solutions Inc.</dd>
<dt class="text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Address</dt>
<dd class="m-0 font-medium">—</dd>
<dt class="text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">TIN</dt>
<dd class="m-0 font-medium">—</dd>
<dt class="text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Attention</dt>
<dd class="m-0 font-medium whitespace-pre-line">Carlo Mendiola</dd>
</dl>
<table aria-label="Invoice" class="mb-3 w-full border-collapse border border-paper-ink">
<tbody>
<tr class=" bg-paper-tint">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.14em] text-paper-gold uppercase">Invoice No.</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums text-sm font-bold">010097-2026</td>
</tr>
<tr class="border-t border-paper-line ">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Invoice date</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums font-semibold">October 1, 2026</td>
</tr>
<tr class="border-t border-paper-line ">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Due date</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums font-semibold">October 15, 2026</td>
</tr>
</tbody>
</table>
<table class="my-2 w-full border-collapse border border-paper-ink">
<thead>
<tr class="border-b border-paper-line bg-paper-tint text-left text-[11px] font-semibold tracking-[0.14em] text-paper-gold uppercase">
