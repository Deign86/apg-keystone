<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums font-semibold">₱399,000.00</td>
</tr>
<tr class="border-t border-paper-line ">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">VAT (12%)</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums font-semibold">₱47,880.00</td>
</tr>
<tr class="border-t border-paper-line ">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Less: EWT (5%)</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums font-semibold">(₱19,950.00)</td>
</tr>
<tr class="border-t border-paper-line bg-paper-tint">
<th scope="row" class="px-2.5 py-1.5 text-left font-semibold text-[11px] font-semibold tracking-[0.14em] text-paper-gold uppercase">Total amount due</th>
<td class="px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums text-sm font-bold">₱426,930.00</td>
</tr>
</tbody>
</table>
<section class="mt-4">
<p class="m-0 text-[11px] font-semibold tracking-[0.14em] text-paper-gold uppercase">Penalty</p>
<p class="m-0 mt-1 text-[11px] whitespace-pre-line">5% penalty charge will be applied to delayed monthly payments.</p>
</section>
<div class="mt-14 grid break-inside-avoid gap-8" style="grid-template-columns: repeat(3, minmax(0,1fr));">
<div class="relative border-t border-paper-ink pt-1 text-[11px]">
<p class="m-0 min-h-4 font-bold">
</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Prepared by</p>
