<p class="m-0 text-xs font-medium tabular-nums">November 3, 2026</p>
</div>
</div>
</header>
<dl class="m-0 mb-3 grid grid-cols-[auto_minmax(0,1fr)_auto_minmax(0,1fr)] border border-paper-ink">
