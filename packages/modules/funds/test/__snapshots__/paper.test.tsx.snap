<dd class="m-0 flex items-center py-1.5 pr-2.5 tabular-nums font-bold uppercase border-b border-paper-line">November 2, 2026</dd>
<dt class="flex items-center py-1.5 pr-3 pl-2.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase  ">For</dt>
<dd class="m-0 flex items-center py-1.5 pr-2.5 tabular-nums font-bold uppercase ">Christmas party venue and catering</dd>
<dt class="flex items-center py-1.5 pr-3 pl-2.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase  border-l border-paper-line">Deadline</dt>
