</tr>
</thead>
<tbody>
<tr class="border-b border-paper-rule align-top bg-paper">
<td class="px-2.5 py-1.5   font-bold uppercase">Venue deposit</td>
<td class="px-2.5 py-1.5 border-l border-paper-line text-right whitespace-nowrap tabular-nums font-bold uppercase">₱30,000.00</td>
</tr>
<tr class="border-b border-paper-rule align-top bg-paper-tint">
<td class="px-2.5 py-1.5   font-bold uppercase">Catering, 60 persons</td>
<td class="px-2.5 py-1.5 border-l border-paper-line text-right whitespace-nowrap tabular-nums font-bold uppercase">₱18,230.55</td>
</tr>
</tbody>
<tfoot>
<tr class="border-t border-paper-ink bg-paper-tint">
<td colspan="1" class="px-2.5 py-1.5 text-right text-[11px] font-semibold tracking-[0.14em] text-paper-gold uppercase">Total</td>
<td class="border-l border-paper-line px-2.5 py-1.5 text-right whitespace-nowrap tabular-nums text-sm font-bold">₱48,230.55</td>
</tr>
</tfoot>
</table>
<div class="mt-20 grid break-inside-avoid gap-8" style="grid-template-columns: repeat(3, minmax(0,1fr));">
<div class="relative border-t border-paper-ink pt-1 text-[11px]">
<p class="m-0 min-h-4 font-bold uppercase">Ana Cruz</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Requested by</p>
</div>
<div class="relative border-t border-paper-ink pt-1 text-[11px]">
<p class="m-0 min-h-4 font-bold uppercase">
</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Checked by</p>
</div>
<div class="relative border-t border-paper-ink pt-1 text-[11px]">
<p class="m-0 min-h-4 font-bold uppercase">Mark Reyes</p>
<p class="m-0 mt-0.5 text-[11px] font-semibold tracking-[0.08em] text-paper-muted uppercase">Approved by</p>
</div>
</div>
<p class="m-0 mt-3 text-[11px] font-medium text-pretty">Approved in Keystone by Mark Reyes on November 3, 2026 at 14:02.</p>
</article>
</div>
</div>",
}
